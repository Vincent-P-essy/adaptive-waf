# LLM adjudicator (optional): Claude decides the narrow ambiguous band.
# ANTHROPIC_API_KEY=sk-ant-...
AWAF_MODEL=claude-opus-4-8

# Decision thresholds on the Isolation Forest anomaly score (0..1).
AWAF_BLOCK_THRESHOLD=0.62
AWAF_AMBIGUOUS_BAND=0.08

# Path to a CSIC 2010 CSV; synthetic corpus is generated when unset.
# CSIC_PATH=/data/csic2010.csv
